DATABASE_URL=jdbc:postgresql://localhost:5432/life_admin
DATABASE_USERNAME=life_admin
DATABASE_PASSWORD=replace-with-your-local-password
DOCUMENT_STORAGE_TYPE=local
DOCUMENT_STORAGE_LOCAL_PATH=./uploads
FRONTEND_URL=http://localhost:3000

# Optional: analysis returns a clear 503 message without a key. Never put this in Next.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_RECEIPT_MODEL=gpt-5.4-mini

# Development samples require BOTH the dev profile and this explicit flag.
# SPRING_PROFILES_ACTIVE=dev
LIFE_ADMIN_DEV_MOCKS=false

# HTTP localhost only. The prod profile always enables Secure cookies.
COOKIE_SECURE=false

# Production: SPRING_PROFILES_ACTIVE=prod; explicit HTTPS FRONTEND_URL, managed
# DATABASE_URL with sslmode=verify-full, DB credentials, and persistent local path.
# Legacy STORAGE_DIRECTORY is still accepted outside prod.
COOKIE_SAME_SITE=strict
